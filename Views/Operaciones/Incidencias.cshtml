@model List<Incidencia>
@{
    ViewData["Title"] = "Incidencias";
    var termino = ViewData["Termino"] as string ?? string.Empty;
    var hayBusqueda = !string.IsNullOrEmpty(termino);
    var degradada = ViewData["Degradada"] as bool? == true;
}

<style>
    .incidencias-page h1 {
        font-size: 1.85rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: #1f2937;
    }

    .tarjeta-incidencias,
    .tarjeta-busqueda {
        border: 0;
        border-radius: 1rem;
        overflow: hidden;
    }

    .barra-busqueda .form-control,
    .barra-busqueda .btn {
        transition: box-shadow 0.15s ease-in-out, transform 0.15s ease-in-out, background-color 0.15s ease-in-out;
    }

    .barra-busqueda .form-control:focus {
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.2);
    }

    .barra-busqueda .btn-primary:hover,
    .barra-busqueda .btn-primary:focus {
        box-shadow: 0 0.4rem 0.9rem rgba(13, 110, 253, 0.35);
    }

    .barra-busqueda .btn-outline-secondary:hover {
        box-shadow: 0 0.35rem 0.8rem rgba(108, 117, 125, 0.25);
    }

    .cabecera-tabla {
        background-color: #f8f9fa;
        border-bottom: 1px solid #e9ecef;
    }

    .cabecera-tabla th {
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #6c757d;
        padding: 1rem;
        white-space: nowrap;
    }

    .tabla-incidencias td {
        padding: 1rem;
        vertical-align: middle;
    }

    .tabla-incidencias tbody tr:last-child td {
        border-bottom: 0;
    }

    .estacion-tag {
        display: inline-block;
        font-weight: 600;
        color: #0d6efd;
        background-color: #e7f1ff;
        border-radius: 0.5rem;
        padding: 0.3rem 0.7rem;
    }

    .descripcion-texto {
        color: #495057;
        max-width: 42ch;
    }

    .btn-cerrar {
        transition: transform 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

    .btn-cerrar:hover,
    .btn-cerrar:focus {
        transform: translateY(-1px);
        box-shadow: 0 0.35rem 0.9rem rgba(220, 53, 69, 0.3);
    }

    .btn-cerrar:active {
        transform: translateY(0);
    }

    .estado-vacio {
        border: 2px dashed #dee2e6;
        border-radius: 1rem;
        background-color: #fbfcfd;
    }
</style>

<div class="incidencias-page row g-4">
    <div class="col-12 col-xl-11">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h1>Incidencias abiertas con consulta rápida</h1>
                <p class="text-secondary mb-0">
                    @if (hayBusqueda && degradada)
                    {
                        <span>Busqueda no disponible en Algolia: se muestra el listado local completo de incidencias abiertas.</span>
                    }
                    else if (hayBusqueda)
                    {
                        <span>Resultados de Algolia para <strong class="text-dark">"@termino"</strong> entre las incidencias abiertas.</span>
                    }
                    else
                    {
                        <span>Incidencias con estado <strong>Abierta</strong> pendientes de cierre, servidas desde la cache distribuida.</span>
                    }
                </p>
            </div>
            <span class="badge rounded-pill @(hayBusqueda ? "text-bg-dark" : "text-bg-primary") px-3 py-2 align-self-start align-self-md-auto">
                @Model.Count @(Model.Count == 1 ? "incidencia" : "incidencias")
            </span>
        </div>

        <div class="card tarjeta-busqueda shadow-sm mb-4">
            <div class="card-body">
                <form asp-controller="Operaciones" asp-action="Incidencias" method="get" class="barra-busqueda row g-2 align-items-end">
                    <div class="col-12 col-md">
                        <label class="form-label fw-semibold text-secondary" for="q">Buscar por estacion o descripcion</label>
                        <input type="search" id="q" name="q" value="@termino" class="form-control"
                               placeholder="Ej. Estacion Central, torniquetes..." autocomplete="off" />
                    </div>
                    <div class="col-12 col-md-auto d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">Buscar</button>
                        <a asp-controller="Operaciones" asp-action="Incidencias" class="btn btn-outline-secondary">Limpiar</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card tarjeta-incidencias shadow-sm">
            <div class="card-body p-0">

                @if (Model.Count == 0)
                {
                    <div class="estado-vacio m-4 p-5 text-center">
                        @if (hayBusqueda)
                        {
                            <h2 class="h5 text-secondary mb-2">Sin coincidencias para "@termino"</h2>
                            <p class="text-secondary mb-0">Prueba con otra estacion o descripcion, o limpia la busqueda para ver todas las abiertas.</p>
                        }
                        else
                        {
                            <h2 class="h5 text-secondary mb-2">No hay incidencias abiertas</h2>
                            <p class="text-secondary mb-0">Todas las incidencias registradas se encuentran cerradas por el momento.</p>
                        }
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover tabla-incidencias mb-0">
                            <thead class="cabecera-tabla">
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Estacion</th>
                                    <th scope="col">Descripcion</th>
                                    <th scope="col">Prioridad</th>
                                    <th scope="col">Estado</th>
                                    <th scope="col" class="text-end">Accion</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var incidencia in Model)
                                {
                                    var clasePrioridad = incidencia.Prioridad switch
                                    {
                                        "Alta" => "text-bg-danger",
                                        "Media" => "text-bg-warning",
                                        "Baja" => "text-bg-success",
                                        _ => "text-bg-secondary"
                                    };

                                    <tr>
                                        <td class="fw-semibold text-secondary">@incidencia.Id</td>
                                        <td><span class="estacion-tag">@incidencia.Estacion</span></td>
                                        <td class="descripcion-texto">@incidencia.Descripcion</td>
                                        <td>
                                            <span class="badge rounded-pill @clasePrioridad">@incidencia.Prioridad</span>
                                        </td>
                                        <td>
                                            <span class="badge rounded-pill text-bg-success">@incidencia.Estado</span>
                                        </td>
                                        <td class="text-end">
                                            <form asp-controller="Operaciones" asp-action="CerrarIncidencia" asp-route-id="@incidencia.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-outline-danger btn-sm btn-cerrar">
                                                    Cerrar
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>
        </div>

    </div>
</div>
